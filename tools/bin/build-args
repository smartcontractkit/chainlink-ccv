#!/usr/bin/env bash
# Prints the build identity as docker build flags, for a caller of `docker build`.
# With --kv, prints KEY=VALUE lines for github actions docker/build-push-action.
# VERSION is a release tag only when HEAD is exactly that tag and no tracked file is modified;
# anything else is the `unset` sentinel. COMMIT_SHA is the full commit, or `unset` without git.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../.."

sha=$(git rev-parse HEAD 2>/dev/null || echo unset)
version=$(git describe --tags --exact-match --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null | sed 's/^v//' || true)
if [ -z "${version}" ] || ! git diff-index --quiet HEAD -- 2>/dev/null; then
	version=unset
fi

if [ "${1:-}" = "--kv" ]; then
	printf 'VERSION=%s\nCOMMIT_SHA=%s\n' "${version}" "${sha}"
else
	echo "--build-arg VERSION=${version} --build-arg COMMIT_SHA=${sha}"
fi
