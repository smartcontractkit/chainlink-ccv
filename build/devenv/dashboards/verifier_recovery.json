  ],
  "templating": {
    "list": [
      {
        "name": "verifier_id",
        "label": "Verifier owner",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(verifier_archive_collection_success, verifier_id)",
        "query": "label_values(verifier_archive_collection_success, verifier_id)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "queue",
        "type": "custom",
        "query": "task-verifier,storage-writer",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
