{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "doc",
      "tags": [],
      "targetBlank": true,
      "title": "Executor balance runbook",
      "type": "link",
      "url": "https://github.com/smartcontractkit/chainlink-ccv/blob/main/docs/runbooks/evm-executor-balance.md"
    }
  ],
  "panels": [
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "content": "Balances are approximate native-token or configured fee-token values. Low-balance thresholds are chain-specific and evaluated by the generated Prometheus rules, not by this dashboard. Use /transmitter-keys or an RPC query for exact base-unit values. Age and absence alerts are required because a read failure can leave an old value.",
        "mode": "markdown"
      },
      "title": "How to read this dashboard",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "One series per assigned executor transmitter and EVM chain. Values use the chain's native token or configured ERC-20 fee token.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Balance (token units)",
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 3 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "node_balance{chainFamily=\"EVM\",chainID=~\"$chain_id\",account=~\"$account\"}",
          "legendFormat": "chain {{chainID}} / {{account}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Executor transmitter balances",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Seconds since the latest sample. Values above 600 seconds trigger the generated stale-series alert.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "Seconds since sample", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 600 },
              { "color": "red", "value": 1200 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "time() - timestamp(node_balance{chainFamily=\"EVM\",chainID=~\"$chain_id\",account=~\"$account\"})",
          "legendFormat": "chain {{chainID}} / {{account}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Balance sample age",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Compare this count with the assigned account/chain inventory used to generate alerts. A smaller count means missing series.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 12 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "count(node_balance{chainFamily=\"EVM\",chainID=~\"$chain_id\",account=~\"$account\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Visible balance series",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Number of chains with at least one visible balance series after applying dashboard filters.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 12 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "count(count by (chainID) (node_balance{chainFamily=\"EVM\",chainID=~\"$chain_id\",account=~\"$account\"}))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Visible chains",
      "type": "stat"
    }
  ],
  "refresh": "30s",
