    @just ../../build/devenv/fakes/build
    @just ../../pricer/build
    @just ../../verifier/build
    @just ../../executor/build
    @just ../../indexer/build
    @just ../../aggregator/build

# Build the service images of a git ref with its own Dockerfiles, and tag them <service>:<tag>.
build-images-at ref tag:
    #!/usr/bin/env bash
    set -euo pipefail
    dir="$(mktemp -d)"
    trap 'git worktree remove --force "$dir"' EXIT
    git worktree add --detach "$dir" "{{ ref }}" >/dev/null
    echo "Building service images of $(git -C "$dir" rev-parse --short HEAD) as :{{ tag }}"
    for svc in verifier executor indexer aggregator; do
        docker build -f "$dir/$svc/Dockerfile" -t "$svc:{{ tag }}" "$dir"
    done
    docker build -f "$dir/verifier/Dockerfile" --build-arg VERIFIER_TYPE=token -t "token-verifier:{{ tag }}" "$dir"

# NOTE: the `from` images replace the local :latest service images, because devenv starts :latest.
# Rolling upgrade test: start devenv on the images of `from`, then upgrade each service to the images of `to`.
upgrade-test from to="HEAD" profile="standard.profile" timeout="30m":
    just build-images-at "{{ from }}" upgrade-from
    just build-images-at "{{ to }}" upgrade-to
    for svc in verifier token-verifier executor indexer aggregator; do docker tag "$svc:upgrade-from" "$svc:latest"; done
    CCV_UPGRADE_FROM_IMAGE_TAG=upgrade-from CCV_UPGRADE_IMAGE_TAG=upgrade-to ccv test --profile {{ profile }} --pattern TestE2EUpgrade_HappyPath --timeout {{ timeout }} --build=false

# Rebuild CLI
cli:
    cd cmd/ccv && go install -ldflags="-X main.Version=1.0.0" . && cd ../..

# Rebuild all (optionally pass config, defaults to env.toml)
rebuild-all config="env.toml":
    echo "Building CLI and all services"
    @just cli
    ccv down
    echo "Cleaning up old images..."
    @just clean-docker
    @just build-docker
    ccv up {{ config }}

# Clone and build job-distributor Docker image
build-jd-docker:
    #!/usr/bin/env bash
    set -e
    REPO_URL="org-25111032@github.com:smartcontractkit/job-distributor.git"
    REPO_DIR="job-distributor/"
    IMAGE_NAME="job-distributor:local"
    DOCKERFILE="e2e/Dockerfile.e2e"
    if docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        echo "Docker image $IMAGE_NAME already exists, skipping build..."
    else
        echo "Cloning repository... check for 2-factor authentication"
        git clone "$REPO_URL" "$REPO_DIR"
        echo "Building Docker image..."
        cd "$REPO_DIR" && docker build -t "$IMAGE_NAME" -f "$DOCKERFILE" .
        cd ..
        rm -rf job-distributor/
    fi
    echo "Done!"
smoke-test:
    cd tests/e2e && go test -v -run TestE2ESmoke

# Install and authenticate with GH CLI
setup-gh:
    #!/usr/bin/env bash
    set -euo pipefail

    required="2.50.0"

    # Convert semver to a zero-padded comparable number, e.g. 2.50.0 -> 002050000
    ver() {
      local v="${1#v}"
      # Ensure we always have 3 fields by appending ".0.0"
      echo "${v}.0.0" \
        | awk -F. '{printf "%03d%03d%03d\n", ($1+0), ($2+0), ($3+0)}'
    }

    # 1) Ensure gh is installed (prefer Homebrew if available)
    if ! command -v gh >/dev/null 2>&1; then
      echo "GitHub CLI not found."
      if command -v brew >/dev/null 2>&1; then
        echo "Installing gh via Homebrew..."
        brew install gh
      else
        echo "Homebrew not found. Please install gh manually (>= v${required})." >&2
        exit 1
      fi
    fi

    # 2) Check version
    have_raw="$(gh --version | head -n1 | awk '{print $3}')"
    have="${have_raw#v}"

    if [[ "$(ver "$have")" -lt "$(ver "$required")" ]]; then
      echo "Found gh v${have}, which is older than required v${required}."

      # 3) If installed by Homebrew, upgrade; else error out
      if command -v brew >/dev/null 2>&1 && brew list gh >/dev/null 2>&1; then
        echo "gh appears to be managed by Homebrew. Upgrading..."
        brew upgrade gh
      else
        echo "gh is not managed by Homebrew. Please upgrade manually to at least v${required}." >&2
        exit 1
      fi
    else
      echo "gh v${have} meets requirement (>= v${required})."
    fi

    # 4) Ensure authentication
    if ! gh auth status >/dev/null 2>&1; then
      echo "GitHub CLI not authenticated. Running gh auth login..."
      gh auth login
    else
      echo "GitHub CLI is already authenticated."
    fi
