package views

// Layout is the shared page frame. Keep styling inline; the CSP allows 'unsafe-inline'
// for style only.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — CCV admin</title>
			<script src="/static/htmx.min.js"></script>
			<style>
				body { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; margin: 2rem; max-width: 72rem; color: #1a1a1a; }
				nav a { margin-right: 1rem; }
				table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
				th, td { border: 1px solid #ccc; padding: 0.35rem 0.6rem; text-align: left; vertical-align: top; }
				th { background: #f3f3f3; }
				.state-ready { color: #067306; }
				.state-unreachable { color: #a40000; }
				.banner { background: #fff7d6; border: 1px solid #d6c66b; padding: 0.6rem; margin: 1rem 0; }
				.error { background: #fdecec; border: 1px solid #e0a0a0; padding: 0.6rem; margin: 1rem 0; }
				code.mid { word-break: break-all; }
				form.inline { display: inline; }
				textarea { width: 100%; min-height: 4rem; font-family: inherit; }
			</style>
		</head>
		<body>
			<nav>
				<strong>CCV admin</strong>
				<a href="/">Nodes</a>
				<a href="/search">Message search</a>
				<a href="/recovery">Source recovery</a>
				<a href="/backfill">Indexer backfill</a>
				<a href="/actions">Action log</a>
			</nav>
			<hr/>
			{ children... }
		</body>
	</html>
}

templ ErrorPage(title, detail string) {
	@Layout(title) {
		<h1>{ title }</h1>
		<div class="error">{ detail }</div>
	}
}

templ PlaceholderPage(title, detail string) {
	@Layout(title) {
		<h1>{ title }</h1>
		<div class="banner">{ detail }</div>
	}
}

// CSRFField is the hidden input every mutation form must include.
templ CSRFField(token string) {
	<input type="hidden" name="csrf_token" value={ token }/>
}
